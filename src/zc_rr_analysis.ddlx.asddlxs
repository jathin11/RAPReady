@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName: 'Readiness Analysis',
  typeNamePlural: 'Readiness Analyses',
  title: { type: #STANDARD, value: 'ScopePackage' },
  description: { type: #STANDARD, value: 'TransportRequest' }
}

annotate view ZC_RR_Analysis with
{
  @UI.hidden: true
  AnalysisUUID;

  @EndUserText.label: 'Package'
  @UI.selectionField: [ { position: 10 } ]
  @UI.lineItem: [
    { position: 10, importance: #HIGH },
    { type: #FOR_ACTION, dataAction: 'Analyze', label: 'Analyze', position: 1 },
    { type: #FOR_ACTION, dataAction: 'Reset', label: 'Reset', position: 2 }
  ]
  @UI.identification: [
    { position: 10 },
    { type: #FOR_ACTION, dataAction: 'Analyze', label: 'Analyze', position: 1 },
    { type: #FOR_ACTION, dataAction: 'Reset', label: 'Reset', position: 2 }
  ]
  @UI.facet: [
    { id: 'Summary', type: #IDENTIFICATION_REFERENCE, label: 'Analysis Summary', position: 10 },
    { id: 'Findings', type: #LINEITEM_REFERENCE, label: 'Findings', position: 20, targetElement: '_Findings' },
    { id: 'Objects', type: #LINEITEM_REFERENCE, label: 'Scanned Objects', position: 30, targetElement: '_Objects' },
    { id: 'Admin', type: #FIELDGROUP_REFERENCE, label: 'Administrative Data', position: 40, targetQualifier: 'Admin' }
  ]
  ScopePackage;

  @EndUserText.label: 'Transport Request or Task'
  @UI.selectionField: [ { position: 20 } ]
  @UI.lineItem: [ { position: 20, importance: #HIGH } ]
  @UI.identification: [ { position: 20 } ]
  TransportRequest;

  @UI.selectionField: [ { position: 30 } ]
  @UI.lineItem: [ { position: 30, criticality: 'StatusCriticality', importance: #HIGH } ]
  @UI.identification: [ { position: 30, criticality: 'StatusCriticality' } ]
  Status;

  @UI.hidden: true
  StatusCriticality;

  @UI.lineItem: [ { position: 40 } ]
  @UI.identification: [ { position: 40 } ]
  ObjectCount;

  @UI.lineItem: [ { position: 50 } ]
  @UI.identification: [ { position: 50 } ]
  ErrorCount;

  @UI.lineItem: [ { position: 60 } ]
  @UI.identification: [ { position: 60 } ]
  WarningCount;

  @UI.identification: [ { position: 70 } ]
  InfoCount;

  @UI.dataPoint: { title: 'Readiness Score', visualization: #PROGRESS, targetValue: 100 }
  @UI.lineItem: [ { position: 70, importance: #HIGH } ]
  @UI.identification: [ { position: 80 } ]
  Score;

  @UI.fieldGroup: [ { qualifier: 'Admin', position: 10 } ]
  CreatedBy;

  @UI.fieldGroup: [ { qualifier: 'Admin', position: 20 } ]
  CreatedAt;

  @UI.fieldGroup: [ { qualifier: 'Admin', position: 30 } ]
  LastChangedBy;

  @UI.fieldGroup: [ { qualifier: 'Admin', position: 40 } ]
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
